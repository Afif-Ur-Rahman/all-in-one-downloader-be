{
  "name": "aio-downloader-api",
  "version": "1.0.0",
  "description": "API for All in One Downloader (Express, TypeScript, yt-dlp)",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "node scripts/install-yt-dlp.mjs",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "tsc && tsc-alias",
    "prepare": "husky",
    "lintFix": "npx eslint \"src/**/*.{ts,js}\" --fix",
    "format": "npx prettier --write \"src/**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5",
    "express-rate-limit": "^7.5.0",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^7.1.0",
    "youtube-dl-exec": "^3.1.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5",
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,json}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
